# Copy to .env.local for local work. On Vercel, add the same names under Project -> Settings -> Environment Variables, then redeploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). Leave empty to preview the home page with built-in sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (use test keys until go-live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM=Formula 5 <orders@yourdomain.com>
ADMIN_NOTIFY_EMAIL=

# Optional
NEXT_PUBLIC_META_PIXEL_ID=
